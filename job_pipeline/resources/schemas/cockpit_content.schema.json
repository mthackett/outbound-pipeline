{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate Cockpit Render Content",
  "type": "object",
  "required": [
    "pages"
  ],
  "properties": {
    "document_title": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "null"
        ]
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "tool_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "template_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "job": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "resume": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "generation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "strategy": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": [
        "title",
        "columns"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/section"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "title",
        "kind"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "bullets",
            "lines",
            "skills",
            "mixed"
          ]
        },
        "items": {
          "type": "array"
        },
        "blocks": {
          "type": "array"
        },
        "note": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$id": "cockpit_content.schema.json"
}