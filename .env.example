# ==============================================================================
# Outbound Job Application Pipeline & Apply Cockpit - Environment Variables
# ==============================================================================

# 1. OpenAI API Key (Required for auto-extraction and role intelligence)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# 2. Google Workspace Configuration
GOOGLE_SPREADSHEET_ID=your-google-spreadsheet-id-here
GOOGLE_RESUMES_FOLDER_ID=your-google-drive-resumes-folder-id-here
GOOGLE_APPLICATIONS_ROOT_FOLDER_ID=your-google-drive-applications-root-folder-id-here

# 3. Google Service Account Credentials
# Option A (Local Development): Path to service account credentials file
GOOGLE_CREDENTIALS_PATH=credentials.json

# Option B (Railway / Cloud Deployment): Raw JSON string of credentials.json
# Paste the entire content of your credentials.json file into this variable in Railway:
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}

# 4. Optional / Future Integrations
DEMO_MODE=false
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...
