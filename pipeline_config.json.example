{
  "enable_cli_logging": true,
  "sources": [
    "LinkedIn",
    "Indeed",
    "ZipRecruiter",
    "Company Website"
  ],
  "priorities": [
    "High",
    "Medium",
    "Low"
  ],
  "telemetry_rules": [
    {
      "id": "warn-travel-requirement",
      "name": "High Travel Requirement",
      "category": "warning",
      "match_mode": "concept",
      "patterns": [
        "50% travel",
        "75% travel",
        "frequent travel",
        "extensive travel"
      ],
      "keywords": [
        "50% travel",
        "75% travel",
        "frequent travel",
        "extensive travel"
      ],
      "concept_description": "Role includes a substantial recurring travel requirement. Exclude optional or occasional travel and descriptions of other roles.",
      "explanation": "Job description indicates substantial travel may be required.",
      "domain_category": "Work Arrangement",
      "severity": "Warning",
      "enabled": true,
      "case_sensitive": false
    },
    {
      "id": "warn-onsite-requirement",
      "name": "Full-Time On-Site Requirement",
      "category": "warning",
      "match_mode": "concept",
      "patterns": [
        "fully onsite",
        "fully on-site",
        "five days onsite",
        "5 days onsite",
        "in office five days"
      ],
      "keywords": [
        "fully onsite",
        "fully on-site",
        "five days onsite",
        "5 days onsite",
        "in office five days"
      ],
      "concept_description": "Role requires full-time on-site attendance. Exclude optional office use and hybrid arrangements.",
      "explanation": "Job description indicates a full-time on-site work requirement.",
      "domain_category": "Work Arrangement",
      "severity": "Warning",
      "enabled": true,
      "case_sensitive": false
    },
    {
      "id": "warn-short-term-contract",
      "name": "Short-Term Contract",
      "category": "warning",
      "match_mode": "concept",
      "patterns": [
        "3 month contract",
        "three month contract",
        "6 month contract",
        "six month contract",
        "short-term contract"
      ],
      "keywords": [
        "3 month contract",
        "three month contract",
        "6 month contract",
        "six month contract",
        "short-term contract"
      ],
      "concept_description": "Role is explicitly a short-term contract of six months or less. Exclude probation periods, project milestones, and contracts longer than six months.",
      "explanation": "Job description indicates a short-term contract engagement.",
      "domain_category": "Employment Type",
      "severity": "Warning",
      "enabled": true,
      "case_sensitive": false
    }
  ],
  "telemetry_warnings": [
    {
      "id": "warn-travel-requirement",
      "name": "High Travel Requirement",
      "category": "warning",
      "match_mode": "concept",
      "patterns": [
        "50% travel",
        "75% travel",
        "frequent travel",
        "extensive travel"
      ],
      "keywords": [
        "50% travel",
        "75% travel",
        "frequent travel",
        "extensive travel"
      ],
      "concept_description": "Role includes a substantial recurring travel requirement. Exclude optional or occasional travel and descriptions of other roles.",
      "explanation": "Job description indicates substantial travel may be required.",
      "domain_category": "Work Arrangement",
      "severity": "Warning",
      "enabled": true,
      "case_sensitive": false
    },
    {
      "id": "warn-onsite-requirement",
      "name": "Full-Time On-Site Requirement",
      "category": "warning",
      "match_mode": "concept",
      "patterns": [
        "fully onsite",
        "fully on-site",
        "five days onsite",
        "5 days onsite",
        "in office five days"
      ],
      "keywords": [
        "fully onsite",
        "fully on-site",
        "five days onsite",
        "5 days onsite",
        "in office five days"
      ],
      "concept_description": "Role requires full-time on-site attendance. Exclude optional office use and hybrid arrangements.",
      "explanation": "Job description indicates a full-time on-site work requirement.",
      "domain_category": "Work Arrangement",
      "severity": "Warning",
      "enabled": true,
      "case_sensitive": false
    },
    {
      "id": "warn-short-term-contract",
      "name": "Short-Term Contract",
